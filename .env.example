# Convex – vyplní se automaticky příkazem `npx convex dev` / `npx convex deploy`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Zakládací token pro master účet.
#
# Nastavuje se v Convexu (Settings → Environment Variables), ne tady: čte ho
# server, ne prohlížeč. Bez něj se master účet založit nedá.
# Hodnota musí mít alespoň 20 znaků; vygeneruj si vlastní, například:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Jakmile master účet existuje, token ztrácí moc: zakládání projde jen tehdy,
# když v databázi zatím není žádný kouč.
SETUP_TOKEN=
